# Acrescente somente à configuração privada .env.gcp usada na máquina de migração.
# pip install '.[migration]'. Nunca copiar origem/credenciais para a imagem Cloud Run.
# PG_DSN tem precedência; deixe vazio para usar campos PG_*.
PG_DSN=
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=dados_globo
PG_USER=
PG_PASSWORD=
PG_SCHEMA=orcamento
PG_SSLMODE=require
# Pasta com pipeline_state_orcamento_18429499488.sqlite3 correspondente ao banco.
RUNTIME_DIR=/CAMINHO/PRIVADO/runtime
