// v4: importar sla_orcamento. Criar UMA medida por vez; argumentos com vírgula.
Projetos = DISTINCTCOUNT('sla_orcamento'[item_sk])

Passagens = COUNTROWS('sla_orcamento')

Passagens Comprovadas = CALCULATE([Passagens], 'sla_orcamento'[qualidade_historico] = "observed")

Horas por Status = SUM('sla_orcamento'[duracao_horas])

Retornos = CALCULATE(COUNTROWS('sla_orcamento'), 'sla_orcamento'[eh_retorno] = TRUE())

Projetos na Fila = CALCULATE([Projetos], 'sla_orcamento'[projeto_na_fila] = TRUE())

Passagens Observadas Encerradas = CALCULATE([Passagens], 'sla_orcamento'[elegivel_comparacao] = TRUE())

Projetos da Amostra = CALCULATE([Projetos], 'sla_orcamento'[elegivel_comparacao] = TRUE())

Horas Observadas Encerradas = SUM('sla_orcamento'[horas_observadas_encerradas])

Media por Passagem h = AVERAGE('sla_orcamento'[horas_observadas_encerradas])

Mediana por Passagem h = MEDIAN('sla_orcamento'[horas_observadas_encerradas])

P95 por Passagem h = PERCENTILEX.INC(FILTER('sla_orcamento', 'sla_orcamento'[elegivel_comparacao] = TRUE()), 'sla_orcamento'[duracao_horas], 0.95)

Tempo desde Entrada h = IF(HASONEVALUE('sla_orcamento'[item_sk]), MAX('sla_orcamento'[tempo_desde_entrada_horas]))

Tempo no Status Atual h = IF(HASONEVALUE('sla_orcamento'[item_sk]), MAX('sla_orcamento'[tempo_status_atual_horas]))

Status Atual Projeto = IF(HASONEVALUE('sla_orcamento'[item_sk]), SELECTEDVALUE('sla_orcamento'[status_atual_nome]))

Etapas Percorridas = IF(HASONEVALUE('sla_orcamento'[item_sk]), DISTINCTCOUNT('sla_orcamento'[status_id]))

Ultimo Corte = MAX('sla_orcamento'[corte_local])

Mediana Validacao Talento h = CALCULATE([Mediana por Passagem h], KEEPFILTERS('sla_orcamento'[status_nome] = "Em revisão - Validação Talento"))

Mediana Retorno Marca h = CALCULATE([Mediana por Passagem h], KEEPFILTERS('sla_orcamento'[status_nome] = "Em elaboração - Retorno Marca/Executivo"))

Mediana Feedback h = CALCULATE([Mediana por Passagem h], KEEPFILTERS('sla_orcamento'[status_nome] = "Aguardando Feedback"))

Projetos Amostra Talento = CALCULATE([Projetos da Amostra], KEEPFILTERS('sla_orcamento'[status_nome] = "Em revisão - Validação Talento"))

Horas Uteis por Status = SUM('sla_orcamento'[duracao_horas_uteis])

Media por Passagem h Uteis = AVERAGE('sla_orcamento'[horas_uteis_observadas_encerradas])

Mediana por Passagem h Uteis = MEDIAN('sla_orcamento'[horas_uteis_observadas_encerradas])

P95 por Passagem h Uteis = PERCENTILEX.INC(FILTER('sla_orcamento', 'sla_orcamento'[elegivel_comparacao] = TRUE()), 'sla_orcamento'[horas_uteis_observadas_encerradas], 0.95)

Tempo desde Entrada h Uteis = IF(HASONEVALUE('sla_orcamento'[item_sk]), MAX('sla_orcamento'[tempo_desde_entrada_horas_uteis]))

Tempo no Status Atual h Uteis = IF(HASONEVALUE('sla_orcamento'[item_sk]), MAX('sla_orcamento'[tempo_status_atual_horas_uteis]))

