# Copie para .env; o arquivo real nunca deve ser versionado.
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2026-04
MONDAY_HTTP_TRANSPORT=requests
DOCKER_HTTP_TRANSPORT=requests
MONDAY_BOARD_ID=18429499488
MONDAY_STATUS_COLUMN_ID=status_19
STATUS_COLUMN_LABELS_OVERRIDE={}
# IDs explícitos apenas quando houver títulos ambíguos. Ex.: {"marca":"text_abc"}
BUSINESS_COLUMNS_OVERRIDE={}
FINAL_STATUS_LABELS=[]
INITIAL_STATUS_LABEL=Entrada
PREFERRED_TIMEZONE=America/Sao_Paulo
RUN_WINDOW_HOURS=24
OVERLAP_MINUTES=30
BACKFILL_FROM=2000-01-01T00:00:00Z
ACTIVITY_WINDOW_DAYS=30
MONDAY_PAGE_SIZE=100
MONDAY_LOG_PAGE_SIZE=100
MONDAY_TIMEOUT_SECONDS=60
MONDAY_MAX_RETRIES=6
TARGET_DB=postgres
# PG_DSN opcional tem precedência sobre os campos abaixo.
PG_DSN=
PG_HOST=127.0.0.1
PG_PORT=55432
PG_DB=sla_workflow
PG_USER=sla_pipeline
PG_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
PG_SCHEMA=sladb
PG_SSLMODE=prefer
# Existing PostgreSQL/VPS: use compose.remote.yaml. Local bundled DB: compose.yaml.
COMPOSE_FILE=compose.yaml
# On the VPS, optional existing Docker network containing the database:
PIPELINE_DOCKER_NETWORK=sls-orcamento-pdd-remote_default
PIPELINE_NETWORK_EXTERNAL=false
BQ_PROJECT=
BQ_DATASET=sla_orcamento_pdd
BQ_LOCATION=US
BQ_KEYFILE=
RUNTIME_DIR=runtime
CRON_SCHEDULE="0 6 * * *"
