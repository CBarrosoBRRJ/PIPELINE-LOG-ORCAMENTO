# Local opcional: copie para .env.gcp e use sla-pipeline --env-file .env.gcp COMANDO.
# Preserve qualquer .env anterior. Cloud Run NÃO usa este arquivo: usa envs/Secret Manager.
# O arquivo real nunca deve ser versionado.
MONDAY_API_TOKEN=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2026-04
MONDAY_BOARD_ID=18429499488
MONDAY_STATUS_COLUMN_ID=status_19
STATUS_COLUMN_LABELS_OVERRIDE={}
# IDs explícitos apenas quando houver títulos ambíguos. Ex.: {"marca":"text_abc"}
BUSINESS_COLUMNS_OVERRIDE={}
FINAL_STATUS_LABELS=["Encerrado","Declinado pelo Mercado","Declinado Internamente"]
INITIAL_STATUS_LABEL=Entrada
PREFERRED_TIMEZONE=America/Sao_Paulo
RUN_WINDOW_HOURS=24
OVERLAP_MINUTES=30
BACKFILL_FROM=2000-01-01T00:00:00Z
ACTIVITY_WINDOW_DAYS=30
MONDAY_PAGE_SIZE=100
MONDAY_LOG_PAGE_SIZE=100
MONDAY_TIMEOUT_SECONDS=60
MONDAY_MAX_RETRIES=6
TARGET_DB=bigquery
# PG_* não são usados no Job. Para migrar, veja migration.env.example.
BQ_PROJECT=gglobo-viu-dados-hdg-prd
BQ_DATASET=viu_agenciamento
BQ_TABLE=sla_orcamento
BQ_LOCATION=US
# ADC local / service account associada ao Job. Keyfiles não são usados em GCP.
BQ_KEYFILE=
GCS_BUCKET=
GCS_PREFIX=sla_orcamento
BQ_JOB_TIMEOUT_SECONDS=1200
# Nacionais automáticos (BR PUBLIC); só acrescentar feriados locais/recessos aqui.
BUSINESS_HOLIDAYS=[]
# Agenda externa: Cloud Scheduler 0 6 * * *, America/Sao_Paulo.
